# Application Environment
APP_ENV=development
APP_NAME="DevPulse AI"
DEBUG=true
PORT=8000

# Security & Authentication
SECRET_KEY=devpulse_super_secret_jwt_key_change_in_production_32chars!
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
# For PostgreSQL: postgresql+asyncpg://devpulse:devpulse_password@localhost:5432/devpulse_db
# Standalone SQLite fallback: sqlite+aiosqlite:///./devpulse.db
DATABASE_URL=sqlite+aiosqlite:///./devpulse.db
DATABASE_ECHO=false

# Redis (Optional: if empty or unreachable, in-memory mock fallback activates)
REDIS_URL=redis://localhost:6379/0

# AI Configuration (Gemini API)
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Telemetry Configuration
TELEMETRY_RETENTION_DAYS=14
MAX_REQUEST_BODY_SIZE=65536
TELEMETRY_SAMPLING_RATE=1.0

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000

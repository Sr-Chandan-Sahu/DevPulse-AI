FROM python:3.10-slim

WORKDIR /workspace

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace/apps/api

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/requirements.txt /workspace/apps/api/requirements.txt
COPY packages/devpulse-sdk /workspace/packages/devpulse-sdk

RUN pip install --no-cache-dir -r /workspace/apps/api/requirements.txt
RUN pip install --no-cache-dir -e /workspace/packages/devpulse-sdk

COPY apps/api /workspace/apps/api
COPY scripts /workspace/scripts

CMD ["python", "scripts/generate_demo_data.py", "--continuous"]
